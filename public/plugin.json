    "todo_create_template": {
      "description": "创建一个任务模板，用于快速创建预设任务",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "模板名称"
          },
          "title": {
            "type": "string",
            "description": "预设任务标题"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ],
            "description": "预设优先级，默认 medium"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "预设标签"
          },
          "group": {
            "type": "string",
            "description": "预设分组"
          },
          "description": {
            "type": "string",
            "description": "预设描述（Markdown）"
          },
          "subtasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "completed": {
                  "type": "boolean"
                }
              },
              "required": [
                "title"
              ]
            },
            "description": "预设子任务"
          },
          "reminder_offset": {
            "type": "number",
            "description": "预设提醒提前分钟数"
          },
          "repeat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "custom"
                ],
                "description": "重复类型：daily=每 N 天，weekly=每 N 周，monthly=每 N 月，custom=每 N 天"
              },
              "interval": {
                "type": "number",
                "description": "间隔数（必须为正数）"
              },
              "repeat_until": {
                "type": "string",
                "description": "重复截止时间 ISO 8601（可选，到此时间后停止生成）"
              },
              "repeat_count": {
                "type": "number",
                "description": "最多生成实例数（可选，不含原始任务）"
              }
            },
            "required": [
              "type",
              "interval"
            ],
            "description": "预设重复规则"
          }
        },
        "required": [
          "name",
          "title"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "template_id",
          "name"
        ]
      }
    },
