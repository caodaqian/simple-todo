            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "parent_task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "subtask_id",
          "title",
          "completed"
        ]
      }
    },
    "todo_update_subtask": {
      "description": "更新子任务的完成状态、标题或完整任务属性（至少提供一个可更新字段）",
