{
  "main": "index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "features": [
    {
      "code": "todo",
      "explain": "任务管理中心（列表/看板/四象限/日历）",
      "cmds": [
        "todo",
        "待办",
        "任务",
        "清单"
      ]
    }
  ],
  "tools": {
    "todo_create_task": {
      "description": "创建一个新任务",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "任务标题"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ],
            "description": "优先级：low=低，medium=中，high=高，urgent=紧急"
          },
          "parent_task_id": {
            "type": "string",
            "description": "父任务 ID；传入后创建为该任务的子任务"
          },
          "due_date": {
            "type": "string",
            "description": "截止时间，ISO 8601 格式如 2026-06-10T18:00:00+08:00"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "标签列表"
          },
          "group": {
            "type": "string",
            "description": "分组/项目名称"
          },
          "description": {
            "type": "string",
            "description": "任务描述（Markdown 格式）"
          },
          "reminder_offset": {
            "type": "number",
            "description": "提前 due_date 多少分钟提醒（0=到期时提醒，需先有 due_date）"
          },
          "repeat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "custom"
                ],
                "description": "重复类型：daily=每 N 天，weekly=每 N 周，monthly=每 N 月，custom=每 N 天"
              },
              "interval": {
                "type": "number",
                "description": "间隔数（必须为正数）"
              },
              "repeat_until": {
                "type": "string",
                "description": "重复截止时间 ISO 8601（可选，到此时间后停止生成）"
              },
              "repeat_count": {
                "type": "number",
                "description": "最多生成实例数（可选，不含原始任务）"
              }
            },
            "required": [
              "type",
              "interval"
            ],
            "description": "重复规则，任务标记完成后自动生成下一实例"
          }
        },
        "required": [
          "title"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务ID"
          },
          "title": {
            "type": "string",
            "description": "任务标题"
          },
          "status": {
            "type": "string",
            "description": "任务状态"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      }
    },
    "todo_list_tasks": {
      "description": "列出任务，支持按状态、优先级、标签筛选",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "doing",
              "done"
            ],
            "description": "按状态筛选"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ],
            "description": "按优先级筛选"
          },
          "tag": {
            "type": "string",
            "description": "按标签筛选"
          },
          "keyword": {
            "type": "string",
            "description": "按关键词搜索标题或描述"
          },
          "limit": {
            "type": "number",
            "description": "返回数量限制，默认20"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "priority": {
                  "type": "string"
                },
                "due_date": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "parent_task_id": {
                  "type": "string"
                }
              }
            }
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "tasks",
          "total"
        ]
      }
    },
    "todo_complete_task": {
      "description": "将任务标记为已完成",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "description": "任务ID"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      }
    },
    "todo_update_task": {
      "description": "更新任务属性（标题、优先级、截止时间、状态等）",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "description": "任务ID"
          },
          "title": {
            "type": "string",
            "description": "新标题"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "doing",
              "done"
            ],
            "description": "新状态"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "urgent"
            ],
            "description": "新优先级"
          },
          "parent_task_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "设置父任务 ID；传 null 清除父任务"
          },
          "due_date": {
            "type": "string",
            "description": "新截止时间，ISO 8601 格式"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "新标签列表（覆盖）"
          },
          "description": {
            "type": "string",
            "description": "新描述（Markdown）"
          },
          "reminder_offset": {
            "type": "number",
            "description": "提前 due_date 多少分钟提醒；传 null/省略则清除提醒"
          },
          "repeat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "daily",
                  "weekly",
                  "monthly",
                  "custom"
                ],
                "description": "重复类型：daily=每 N 天，weekly=每 N 周，monthly=每 N 月，custom=每 N 天"
              },
              "interval": {
                "type": "number",
                "description": "间隔数（必须为正数）"
              },
              "repeat_until": {
                "type": "string",
                "description": "重复截止时间 ISO 8601（可选，到此时间后停止生成）"
              },
              "repeat_count": {
                "type": "number",
                "description": "最多生成实例数（可选，不含原始任务）"
              }
            },
            "required": [
              "type",
              "interval"
            ],
            "description": "重复规则（覆盖）；传 null/省略则清除重复"
          }
        },
        "required": [
          "task_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      }
    },
    "todo_delete_task": {
      "description": "删除一个任务",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "description": "任务ID"
