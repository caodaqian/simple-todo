          },
          "dueToday": {
            "type": "number"
          },
          "noDueDate": {
            "type": "number"
          }
        },
        "required": [
          "total",
          "byStatus",
          "byPriority",
          "overdue",
          "dueToday",
          "noDueDate"
        ]
      }
    },
