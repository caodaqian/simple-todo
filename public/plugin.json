          "group": {
            "type": "string",
            "description": "新分组"
          },
          "description": {
            "type": "string",
            "description": "新描述（Markdown）"
          }
        },
        "required": [
          "task_id",
          "subtask_id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "subtask_id": {
            "type": "string"
          },
          "completed": {
