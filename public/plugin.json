{
	"$schema": "https://raw.githubusercontent.com/uTools-Labs/utools-api-types/refs/heads/main/resource/utools.schema.json",
	"main": "index.html",
	"preload": "preload/services.js",
	"logo": "logo.png",
	"development": {
		"main": "http://localhost:5173"
	},
	"pluginSetting": {
		"height": 700
	},
	"features": [
		{
			"code": "todo",
			"explain": "任务管理中心（列表/看板/四象限/日历）",
			"cmds": [
				"todo",
				"待办",
				"任务",
				"清单"
			]
		}
	],
	"tools": {
		"todo_create_task": {
			"description": "创建任务。用 due_start/due_end 表示时间点或时间段；全天任务传 all_day=true 且使用 YYYY-MM-DD。子任务也是任务，传 parent_task_id 创建。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"title": {
						"type": "string",
						"description": "任务标题"
					},
					"priority": {
						"type": "string",
						"enum": [
							"low",
							"medium",
							"high",
							"urgent"
						],
						"description": "优先级，默认 medium"
					},
					"parent_task_id": {
						"type": "string",
						"description": "父任务 ID"
					},
					"due_start": {
						"type": "string",
						"description": "开始/到期时间；非全天用 ISO 8601，全天用 YYYY-MM-DD"
					},
					"due_end": {
						"type": "string",
						"description": "结束时间；必须不早于 due_start"
					},
					"all_day": {
						"type": "boolean",
						"description": "是否全天任务；为 true 时 due_start/due_end 必须是 YYYY-MM-DD"
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "标签列表"
					},
					"group": {
						"type": "string",
						"description": "分组/项目名称"
					},
					"description": {
						"type": "string",
						"description": "Markdown 描述"
					},
					"reminder_offset": {
						"type": "number",
						"description": "相对 due_start 提前的提醒分钟数，需有 due_start"
					},
					"repeat": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"type": {
								"type": "string",
								"enum": [
									"daily",
									"weekly",
									"monthly",
									"custom"
								]
							},
							"interval": {
								"type": "number",
								"description": "正间隔；daily/custom 为天，weekly 为周，monthly 为月"
							},
							"repeat_until": {
								"type": "string",
								"description": "停止生成的 ISO 8601 时间"
							},
							"repeat_count": {
								"type": "number",
								"description": "最多生成的后续实例数"
							}
						},
						"required": [
							"type",
							"interval"
						]
					}
				},
				"required": [
					"title"
				]
			}
		},
		"todo_get_task": {
			"description": "按 ID 获取任务详情及其直接子任务。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"task_id": {
						"type": "string"
					}
				},
				"required": [
					"task_id"
				]
			}
		},
		"todo_search_tasks": {
			"description": "搜索任务。日期范围按任务时间段相交匹配；默认不返回已归档任务。可用 parent_task_id 或 root_only 查询层级。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"keyword": {
						"type": "string"
					},
					"status": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"todo",
								"doing",
								"done"
							]
						}
					},
					"priority": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"low",
								"medium",
								"high",
								"urgent"
							]
						}
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"tag_match_mode": {
						"type": "string",
						"enum": [
							"any",
							"all"
						]
					},
					"group": {
						"type": "string"
					},
					"parent_task_id": {
						"type": "string",
						"description": "仅返回指定父任务的直接子任务"
					},
					"root_only": {
						"type": "boolean",
						"description": "仅返回顶层任务"
					},
					"archived": {
						"type": "boolean",
						"description": "是否查询已归档任务，默认 false"
					},
					"due_after": {
						"type": "string",
						"description": "时间范围下界 ISO 8601"
					},
					"due_before": {
						"type": "string",
						"description": "时间范围上界 ISO 8601"
					},
					"include_no_due": {
						"type": "boolean"
					},
					"show_completed": {
						"type": "boolean"
					},
					"sort_by": {
						"type": "string",
						"enum": [
							"priority",
							"dueDate",
							"createdAt",
							"updatedAt"
						]
					},
					"sort_order": {
						"type": "string",
						"enum": [
							"asc",
							"desc"
						]
					},
					"limit": {
						"type": "number"
					},
					"offset": {
						"type": "number"
					}
				}
			}
		},
		"todo_update_task": {
			"description": "更新任务。传 null 可清除 parent_task_id、due_start、due_end、all_day、reminder_offset、repeat 或 archived。将 status 更新为 done 时，存在重复规则会生成下一实例。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"task_id": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"status": {
						"type": "string",
						"enum": [
							"todo",
							"doing",
							"done"
						]
					},
					"priority": {
						"type": "string",
						"enum": [
							"low",
							"medium",
							"high",
							"urgent"
						]
					},
					"parent_task_id": {
						"type": [
							"string",
							"null"
						]
					},
					"due_start": {
						"type": [
							"string",
							"null"
						]
					},
					"due_end": {
						"type": [
							"string",
							"null"
						]
					},
					"all_day": {
						"type": [
							"boolean",
							"null"
						]
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"group": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"reminder_offset": {
						"type": [
							"number",
							"null"
						]
					},
					"repeat": {
						"type": [
							"object",
							"null"
						],
						"additionalProperties": false,
						"properties": {
							"type": {
								"type": "string",
								"enum": [
									"daily",
									"weekly",
									"monthly",
									"custom"
								]
							},
							"interval": {
								"type": "number"
							},
							"repeat_until": {
								"type": "string"
							},
							"repeat_count": {
								"type": "number"
							}
						},
						"required": [
							"type",
							"interval"
						]
					},
					"archived": {
						"type": [
							"boolean",
							"null"
						]
					}
				},
				"required": [
					"task_id"
				]
			}
		},
		"todo_delete_task": {
			"description": "永久删除一个任务及其直接子任务。执行前必须先向用户确认。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"task_id": {
						"type": "string"
					}
				},
				"required": [
					"task_id"
				]
			}
		},
		"todo_bulk_update": {
			"description": "批量更新最多 100 个任务的状态、优先级、分组或归档状态。批量完成重复任务也会生成下一实例。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"task_ids": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"status": {
						"type": "string",
						"enum": [
							"todo",
							"doing",
							"done"
						]
					},
					"priority": {
						"type": "string",
						"enum": [
							"low",
							"medium",
							"high",
							"urgent"
						]
					},
					"group": {
						"type": "string"
					},
					"archived": {
						"type": "boolean"
					}
				},
				"required": [
					"task_ids"
				]
			}
		},
		"todo_get_overview": {
			"description": "获取任务总览、状态/优先级分布、逾期、今日到期、可用标签和分组。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"group": {
						"type": "string"
					}
				}
			}
		},
		"todo_get_review": {
			"description": "获取任务复盘指标：完成率、逾期率、未来七日计划、标签/分组分布和近七日完成趋势。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {}
			}
		},
		"todo_suggest_organization": {
			"description": "仅分析未完成、未归档任务，返回可由用户确认后用 todo_update_task 应用的优先级、分组、标签和日期建议；不会写入数据。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {}
			}
		},
		"todo_list_templates": {
			"description": "列出全部任务模板。children 是模板套用时创建的子任务标题列表。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {}
			}
		},
		"todo_create_template": {
			"description": "创建可复用任务模板。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"name": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"priority": {
						"type": "string",
						"enum": [
							"low",
							"medium",
							"high",
							"urgent"
						]
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"group": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"children": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"reminder_offset": {
						"type": "number"
					},
					"repeat": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"type": {
								"type": "string",
								"enum": [
									"daily",
									"weekly",
									"monthly",
									"custom"
								]
							},
							"interval": {
								"type": "number"
							},
							"repeat_until": {
								"type": "string"
							},
							"repeat_count": {
								"type": "number"
							}
						},
						"required": [
							"type",
							"interval"
						]
					}
				},
				"required": [
					"name",
					"title"
				]
			}
		},
		"todo_update_template": {
			"description": "更新模板字段；children 覆盖模板子任务标题；reminder_offset 或 repeat 传 null 清除。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"template_id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"priority": {
						"type": "string",
						"enum": [
							"low",
							"medium",
							"high",
							"urgent"
						]
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"group": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"children": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"reminder_offset": {
						"type": [
							"number",
							"null"
						]
					},
					"repeat": {
						"type": [
							"object",
							"null"
						],
						"additionalProperties": false,
						"properties": {
							"type": {
								"type": "string",
								"enum": [
									"daily",
									"weekly",
									"monthly",
									"custom"
								]
							},
							"interval": {
								"type": "number"
							},
							"repeat_until": {
								"type": "string"
							},
							"repeat_count": {
								"type": "number"
							}
						},
						"required": [
							"type",
							"interval"
						]
					}
				},
				"required": [
					"template_id"
				]
			}
		},
		"todo_apply_template": {
			"description": "从模板创建一个任务及其扁平子任务。可覆盖标题、标签、分组和计划时间。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"template_id": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"tags": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"group": {
						"type": "string"
					},
					"due_start": {
						"type": "string"
					},
					"due_end": {
						"type": "string"
					},
					"all_day": {
						"type": "boolean"
					}
				},
				"required": [
					"template_id"
				]
			}
		},
		"todo_delete_template": {
			"description": "永久删除模板。执行前必须先向用户确认。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"template_id": {
						"type": "string"
					}
				},
				"required": [
					"template_id"
				]
			}
		},
		"todo_list_due_reminders": {
			"description": "列出当前应提醒或已逾期的未完成任务。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"include_overdue": {
						"type": "boolean"
					},
					"limit": {
						"type": "number"
					}
				}
			}
		},
		"todo_snooze_reminder": {
			"description": "将指定任务的下一次提醒延后指定分钟数。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"task_id": {
						"type": "string"
					},
					"minutes": {
						"type": "number"
					}
				},
				"required": [
					"task_id",
					"minutes"
				]
			}
		},
		"todo_acknowledge_reminder": {
			"description": "确认已处理指定任务的提醒，避免该提醒再次出现在待提醒列表。",
			"inputSchema": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"task_id": {
						"type": "string"
					}
				},
				"required": [
					"task_id"
				]
			}
		}
	}
}