    "todo_get_settings": {
      "description": "读取插件设置（外观模式、强调色、是否显示已完成、默认视图、通知开关）",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "appearanceMode": {
            "type": "string",
            "enum": [
              "light",
