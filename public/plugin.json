        ]
      }
    },
    "todo_search_tasks": {
      "description": "高级搜索任务：支持状态/优先级数组、标签 any/all 匹配、分组、截止日期范围、关键词、是否含已完成、排序与分页",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "keyword": {
            "type": "string",
            "description": "按关键词模糊匹配标题或描述"
          },
          "status": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "done"
              ]
            },
            "description": "按状态筛选，可传单值或数组（如 [\"todo\"] 或 [\"todo\",\"doing\"]）"
          },
          "priority": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "description": "按优先级筛选，可传单值或数组"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "按标签筛选"
          },
          "tag_match_mode": {
            "type": "string",
            "enum": [
              "any",
              "all"
            ],
            "description": "标签匹配模式：any=任一匹配(默认)，all=全部匹配"
          },
          "group": {
            "type": "string",
            "description": "按分组精确匹配"
          },
          "due_after": {
            "type": "string",
            "description": "截止时间下界，ISO 8601 格式"
          },
          "due_before": {
            "type": "string",
            "description": "截止时间上界，ISO 8601 格式"
          },
          "include_no_due": {
            "type": "boolean",
            "description": "日期范围筛选时是否包含无截止日期的任务，默认 false"
          },
          "show_completed": {
            "type": "boolean",
            "description": "是否包含已完成任务，默认 true"
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "priority",
              "dueDate",
              "createdAt",
              "updatedAt"
            ],
            "description": "排序字段，默认 createdAt"
          },
          "sort_order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "排序方向，默认 desc"
          },
          "limit": {
            "type": "number",
            "description": "返回数量限制，默认 50"
          },
          "offset": {
            "type": "number",
            "description": "分页偏移量，默认 0"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "priority": {
                  "type": "string"
                },
                "due_date": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "group": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parent_task_id": {
                  "type": "string"
                }
              }
            }
          },
          "total": {
            "type": "number"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": [
          "tasks",
          "total",
          "limit",
          "offset"
        ]
      }
    },
    "todo_get_overview": {
      "description": "获取任务统计概览：总数、按状态/优先级分布、逾期、今日到期、无截止日期",
