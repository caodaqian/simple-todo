        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "description": "所属任务ID"
          },
          "subtask_id": {
            "type": "string",
            "description": "子任务ID"
          },
          "completed": {
            "type": "boolean",
            "description": "是否完成"
          },
          "title": {
            "type": "string",
            "description": "新标题"
          },
          "status": {
            "type": "string",
